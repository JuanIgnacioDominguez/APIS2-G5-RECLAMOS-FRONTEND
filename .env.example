# URL base de la API de Reclamos (backend Grupo 5).
# En desarrollo apunta al FastAPI local; en produccion, a la URL desplegada.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Access token de Jawg Maps para las tiles del mapa (estilo Jawg Lagoon).
# Se obtiene gratis en https://www.jawg.io. Sin token, el mapa cae a
# OpenStreetMap. Es un token de cliente: restringilo a tus dominios en Jawg.
VITE_JAWG_ACCESS_TOKEN=

# Tablero de Analitica (Grupo 8). Se pide con el token del usuario y se muestra
# en un iframe. Si se omite, usa la URL de produccion de Analitica.
VITE_ANALITICA_URL=

# Staff signs in through the Login Federado. Set to true only against a local
# backend that still mounts the dev login (AUTH_DEV_LOGIN_ENABLED=true).
VITE_LOGIN_DEV=false
