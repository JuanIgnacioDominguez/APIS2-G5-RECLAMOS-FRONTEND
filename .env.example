# URL base de la API de Reclamos (backend Grupo 5).
# En desarrollo apunta al FastAPI local; en produccion, a la URL desplegada.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Access token de Jawg Maps para las tiles del mapa (estilo Jawg Lagoon).
# Se obtiene gratis en https://www.jawg.io. Sin token, el mapa cae a
# OpenStreetMap. Es un token de cliente: restringilo a tus dominios en Jawg.
VITE_JAWG_ACCESS_TOKEN=
